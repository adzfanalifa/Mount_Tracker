# Salin menjadi mobile/.env lalu restart: npx expo start -c
# Alamat backend. Dari HP JANGAN pakai localhost; pakai IP laptop di WiFi yang sama.
# Cek IP laptop: buka CMD lalu ketik ipconfig (lihat "IPv4 Address").
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
EXPO_PUBLIC_API_TIMEOUT_MS=12000

# Login Google (opsional). Buat di https://console.cloud.google.com/apis/credentials
# Client ID yang sama juga dimasukkan ke GOOGLE_CLIENT_IDS di .env backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
