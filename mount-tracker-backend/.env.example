# Salin file ini menjadi .env lalu sesuaikan isinya.

APP_NAME="Mount Tracker API"
# true hanya untuk pengujian lokal (pesan error detail + kode reset ikut di response)
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# Opsional: alamat publik backend, dipakai untuk URL gambar. Kosong = otomatis.
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mount_tracker
DB_USER=root
DB_PASS=

# WAJIB diganti: string acak minimal 32 karakter.
# Buat dengan: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Masa berlaku token (detik). 604800 = 7 hari
JWT_TTL=604800

CORS_ORIGIN=*

# --- Email (reset password) ---
# Gmail: buat App Password di https://myaccount.google.com/apppasswords
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=akunmu@gmail.com
#   MAIL_PASSWORD=app-password-16-huruf
# Kosongkan MAIL_USERNAME untuk memakai Mailpit Laragon (127.0.0.1:1025, lihat http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mounttracker.local
MAIL_FROM_NAME="Mount Tracker"

# --- Login Google ---
# Client ID OAuth (Web, Android, iOS) dipisah koma. Kosong = login Google nonaktif.
GOOGLE_CLIENT_IDS=

# --- Cuaca (Open-Meteo, tanpa API key) ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL=900

# --- Ambang peringatan kesehatan ---
SPO2_LOW=90
SPO2_CRITICAL=85
